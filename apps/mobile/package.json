{
  "name": "@farm/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "build": "echo 'Mobile builds use EAS (build:android / build:ios)'",
    "build:android": "eas build --profile preview --platform android",
    "build:ios": "eas build --profile preview --platform ios",
    "start": "expo start --port 8082 --offline",
    "android": "expo start --android --port 8082 --offline",
    "ios": "expo start --ios --port 8082 --offline",
    "web": "expo start --web --port 8082 --offline",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@expo/metro-runtime": "^6.1.2",
    "@farm/auth": "workspace:*",
    "@farm/types": "workspace:*",
    "@farm/ui-native": "workspace:*",
    "@farm/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.7.9",
    "expo": "~54.0.35",
    "expo-constants": "^18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "^8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.475.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "^57.0.3",
    "jest": "^29.7.0",
    "metro-runtime": "^0.83.3",
    "ts-jest": "^29.4.11",
    "typescript": "~5.8.3"
  },
  "private": true
}
