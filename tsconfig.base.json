{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@farm/ui/*": ["packages/ui/dist/*"],
      "@farm/types": ["packages/types/dist"],
      "@farm/types/*": ["packages/types/dist/*"],
      "@farm/utils": ["packages/utils/dist"],
      "@farm/utils/*": ["packages/utils/dist/*"],
      "@farm/database": ["packages/database/dist"],
      "@farm/database/*": ["packages/database/dist/*"],
      "@farm/validation": ["packages/validation/dist"],
      "@farm/validation/*": ["packages/validation/dist/*"],
      "@farm/auth": ["packages/auth/dist"],
      "@farm/auth/express": ["packages/auth/dist/express/index"],
      "@farm/auth/nestjs": ["packages/auth/dist/nestjs/index"],
      "@farm/domain-core": ["packages/domain-core/dist"],
      "@farm/domain-core/*": ["packages/domain-core/dist/*"],
      "@farm/identity-domain": ["packages/domains/identity/dist"],
      "@farm/identity-domain/*": ["packages/domains/identity/dist/*"],
      "@farm/farm-domain": ["packages/domains/farm/dist"],
      "@farm/farm-domain/*": ["packages/domains/farm/dist/*"],
      "@farm/crop-domain": ["packages/domains/crop/dist"],
      "@farm/crop-domain/*": ["packages/domains/crop/dist/*"],
      "@farm/livestock-domain": ["packages/domains/livestock/dist"],
      "@farm/livestock-domain/*": ["packages/domains/livestock/dist/*"],
      "@farm/poultry-domain": ["packages/domains/poultry/dist"],
      "@farm/poultry-domain/*": ["packages/domains/poultry/dist/*"],
      "@farm/finance-domain": ["packages/domains/finance/dist"],
      "@farm/finance-domain/*": ["packages/domains/finance/dist/*"],
      "@farm/hr-domain": ["packages/domains/hr/dist"],
      "@farm/hr-domain/*": ["packages/domains/hr/dist/*"],
      "@farm/notification-domain": ["packages/domains/notification/dist"],
      "@farm/notification-domain/*": ["packages/domains/notification/dist/*"],
      "@farm/reporting-domain": ["packages/domains/reporting/dist"],
      "@farm/reporting-domain/*": ["packages/domains/reporting/dist/*"],
      "@farm/platform-domain": ["packages/domains/platform/dist"],
      "@farm/platform-domain/*": ["packages/domains/platform/dist/*"]
    }
  }
}
