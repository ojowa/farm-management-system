{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@farm/ui/*": ["packages/ui/dist/*"],
      "@farm/types": ["packages/types/dist"],
      "@farm/types/*": ["packages/types/dist/*"],
      "@farm/utils": ["packages/utils/dist"],
      "@farm/utils/*": ["packages/utils/dist/*"],
      "@farm/database": ["packages/database/dist"],
      "@farm/database/*": ["packages/database/dist/*"],
      "@farm/validation": ["packages/validation/dist"],
      "@farm/validation/*": ["packages/validation/dist/*"],
      "@farm/auth": ["packages/auth/dist"],
      "@farm/auth/express": ["packages/auth/dist/express/index"],
      "@farm/auth/nestjs": ["packages/auth/dist/nestjs/index"]

    }
  }
}
