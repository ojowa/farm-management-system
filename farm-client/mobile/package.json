{
  "name": "@farm/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "build": "echo 'Mobile builds use EAS (build:android / build:ios)'",
    "build:android": "eas build --profile preview --platform android",
    "build:ios": "eas build --profile preview --platform ios",
    "start": "expo start --port 8082 --offline",
    "android": "expo start --android --port 8082 --offline",
    "ios": "expo start --ios --port 8082 --offline",
    "web": "expo start --web --port 8082 --offline",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:unit": "jest --passWithNoTests",
    "test:component": "jest --testPathPattern='\\.test\\.tsx$' --passWithNoTests",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "orbit": "npx expo start --dev-client --port 8082",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.7.9",
    "expo": "~54.0.35",
    "expo-constants": "^18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~7.0.2",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "detox": "^20.33.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
