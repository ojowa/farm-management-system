{
  "name": "@farm/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "build": "echo 'Mobile builds use EAS (build:android / build:ios)'",
    "build:android": "eas build --profile preview --platform android",
    "build:ios": "eas build --profile preview --platform ios",
    "build:android:prod": "eas build --profile production --platform android",
    "build:ios:prod": "eas build --profile production --platform ios",
    "build:android:local": "eas build --profile development-local --platform android --local",
    "build:ios:local": "eas build --profile development-local --platform ios --local",
    "build:android:preview-local": "eas build --profile preview-local --platform android --local",
    "build:ios:preview-local": "eas build --profile preview-local --platform ios --local",
    "start": "expo start --port 8082",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:unit": "jest --passWithNoTests",
    "test:component": "jest --testPathPattern='\\.test\\.tsx$' --passWithNoTests",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "orbit": "npx expo start --dev-client --port 8082",
    "typecheck": "tsc --noEmit",
    "eas:login": "eas login",
    "eas:setup": "eas build:configure"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.7.9",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-drawer-layout": "^4.2.12",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.3",
    "babel-preset-expo": "~57.0.0",
    "detox": "^20.33.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22",
    "npm": "10.x"
  }
}
