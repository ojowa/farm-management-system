{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4022",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.farmmanagement.com",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.farmmanagement.com",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true,
        "buildType": "app-bundle"
      }
    },
    "development-local": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4022",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-local": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.farmmanagement.com",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "serviceAccountKeyPath": "./google-services.json"
      }
    }
  }
}
