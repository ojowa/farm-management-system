{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.18.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://farm-management-system-farm-server-vert.vercel.app/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://farm-management-system-farm-server-vert.vercel.app/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://farm-management-system-farm-server-vert.vercel.app/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true,
        "buildType": "app-bundle"
      }
    },
    "development-local": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-local": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://farm-management-system-farm-server-vert.vercel.app/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@farmmanagement.com"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "serviceAccountKeyPath": "./google-services.json"
      }
    }
  }
}