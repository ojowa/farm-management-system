# Mobile App Environment Variables
# Copy this file to .env.local and update with your actual values

# API Configuration
# Development: http://192.168.x.x:4000 or http://localhost:4000
# Production:  https://api.yourdomain.com (HTTPS required for Expo Go builds)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Certificate Pinning (production only)
# SHA-256 hash of your server's public key (base64 encoded)
# Generate with: openssl s_client -connect yourdomain.com:443 | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
# EXPO_PUBLIC_CERT_PIN_SHA256=your_base64_encoded_sha256_hash_here
