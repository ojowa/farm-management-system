# ── API ────────────────────────────────────────────────────────────────────────
# Backend API gateway URL (NestJS app-server).
# Must point at the gateway AND include the `/v1` global prefix.
# The gateway listens on API_SERVICE_PORT (farm-server/.env -> 4000).
# Local dev: use your machine IP for physical device testing
#   Android emulator: http://10.0.2.2:4000/v1
#   Physical device:  http://192.168.1.10:4000/v1
# Production: replace with your deployed API URL
EXPO_PUBLIC_API_URL=http://localhost:4000/v1

# ── App Support ────────────────────────────────────────────────────────────────
# Shown in Settings > Help & Support
EXPO_PUBLIC_SUPPORT_EMAIL=support@farmmanagement.com
EXPO_PUBLIC_SUPPORT_PHONE=

# ── Certificate Pinning (production only) ──────────────────────────────────────
# SHA-256 hash of your production SSL certificate (without spaces/colons)
# Generate: openssl x509 -pubkey -noout -in cert.pem | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
EXPO_PUBLIC_CERT_PIN_SHA256=

# Production domain for certificate pinning validation
EXPO_PUBLIC_PRODUCTION_DOMAIN=
