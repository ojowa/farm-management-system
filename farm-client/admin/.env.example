# Copy to .env.local (gitignored) and adjust for your environment.
# NEXT_PUBLIC_* vars are inlined at build time — rebuild after changing them.
#
# Local:  http://localhost:4000/v1  (gateway on port 4000, see farm-server/.env)
# Render: set automatically via render.yaml (https://fms-api.onrender.com/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
