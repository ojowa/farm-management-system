{
  "name": "@farm/admin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 4003",
    "build:packages": "npm run build -w @farm/types && npm run build -w @farm/validation && npm run build -w @farm/auth && npm run build -w @farm/api-client && npm run build -w @farm/hooks && npm run build -w @farm/ui",
    "build": "npm run build:packages && next build --no-lint",
    "start": "next start -p 4003",
    "lint": "echo \"No linter configured\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@farm/api-client": "^1.0.0",
    "@farm/auth": "^1.0.0",
    "@farm/hooks": "^1.0.0",
    "@farm/types": "^1.0.0",
    "@farm/ui": "^1.0.0",
    "@farm/validation": "^1.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true
  }
}
