{
  "name": "@farm/auth",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "paths": ["./dist/paths.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    }
  },
  "private": true,
  "scripts": {
    "build": "npx tsc"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.8.3"
  }
}
