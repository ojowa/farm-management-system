{
  "name": "@farm/app-server",
  "version": "1.0.0",
  "private": true,
  "description": "Microservices - each domain module runs as an independent NestJS HTTP server",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build app-server auth-service farm-service livestock-service poultry-service finance-service hr-service notification-service organization-service platform-service reporting-service crop-service realtime-service",
    "start": "node dist/main",
    "start:auth": "node dist/microservices/auth.main",
    "start:farm": "node dist/microservices/farm.main",
    "start:livestock": "node dist/microservices/livestock.main",
    "start:poultry": "node dist/microservices/poultry.main",
    "start:finance": "node dist/microservices/finance.main",
    "start:hr": "node dist/microservices/hr.main",
    "start:notification": "node dist/microservices/notification.main",
    "start:organization": "node dist/microservices/organization.main",
    "start:platform": "node dist/microservices/platform.main",
    "start:reporting": "node dist/microservices/reporting.main",
    "start:crop": "node dist/microservices/crop.main",
    "start:realtime": "node dist/microservices/realtime.main",
    "start:all-services": "concurrently --names auth,farm,livestock,poultry,finance,hr,notif,org,platform,reporting,crop,realtime --kill-others \"npm run start:auth\" \"npm run start:farm\" \"npm run start:livestock\" \"npm run start:poultry\" \"npm run start:finance\" \"npm run start:hr\" \"npm run start:notification\" \"npm run start:organization\" \"npm run start:platform\" \"npm run start:reporting\" \"npm run start:crop\" \"npm run start:realtime\"",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@farm/auth-server": "^1.0.0",
    "@farm/database": "^1.0.0",
    "@farm/env": "^1.0.0",
    "@farm/types-server": "^1.0.0",
    "@farm/utils": "^1.0.0",
    "@farm/validation-server": "^1.0.0",
    "@nestjs/axios": "^3.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "@otplib/plugin-base32-scure": "^13.4.1",
    "@otplib/plugin-crypto-node": "^13.4.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "concurrently": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.8.3"
  }
}
