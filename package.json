{
  "name": "fms",
  "version": "1.0.0",
  "description": "Farm Management System",
  "private": true,
  "packageManager": "npm@11.10.0",
  "scripts": {
    "dev": "node scripts/start.js --dev",
    "start": "node scripts/start.js",
    "start:services": "node scripts/start.js",
    "start:services:dev": "node scripts/start.js --dev",
    "build:client": "npm --prefix farm-client run build",
    "build:server": "npm --prefix farm-server run build",
    "lint": "echo \"Run lint in farm-client or farm-server individually\""
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "cross-env": "^10.1.0",
    "typescript": "~5.8.3"
  }
}
