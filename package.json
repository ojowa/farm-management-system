{
  "name": "Farm Management System",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "farm client/*",
    "farm client/packages/*",
    "farm server/*",
    "farm server/packages/server/*"
  ],
  "scripts": {
    "test": "turbo test",
    "dev": "turbo dev",
    "build": "turbo build --filter=!@farm/mobile",
    "build:mobile": "npm run build --workspace=@farm/mobile",
    "start": "turbo build && turbo start",
    "lint": "turbo lint",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "@types/react": "18.3.31"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.22.4",
    "turbo": "^2.10.4",
    "typescript": "~5.8.3"
  }
}