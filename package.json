{
  "name": "Farm Management System",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "test": "turbo test",
    "dev": "turbo dev",
    "build": "turbo build --filter=!@farm/mobile",
    "build:mobile": "pnpm --filter @farm/mobile build",
    "build:mobile:android": "pnpm --filter @farm/mobile build:android",
    "build:mobile:ios": "pnpm --filter @farm/mobile build:ios",
    "start": "turbo build && turbo start",
    "lint": "turbo lint",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.22.4",
    "turbo": "^2.10.4",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "core-js",
      "esbuild",
      "@swc/core"
    ],
    "overrides": {
      "@types/react": "18.3.31",
      "typescript": "5.8.3"
    }
  }
}