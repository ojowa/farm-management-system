{
  "name": "@farm/app-server",
  "version": "1.0.0",
  "private": true,
  "description": "Modular monolith - all bounded contexts run in one NestJS HTTP process",
  "main": "dist/main.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && nest build",
    "prestart": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "start": "node dist/main.js",
    "postdeploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "start:prod": "node ../scripts/start-prod.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "migrate:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "npx prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "ts-node prisma/seed.ts",
    "db:check-roles": "ts-node prisma/check-roles.ts",
    "db:check-user": "node prisma/check-user.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "@otplib/plugin-base32-scure": "^13.4.1",
    "@otplib/plugin-crypto-node": "^13.4.1",
    "@prisma/client": "^6.19.3",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.7",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14",
    "concurrently": "^9.0.0",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.8.3"
  }
}