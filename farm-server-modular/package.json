{
  "name": "farm-server-modular",
  "version": "1.0.0",
  "description": "Farm Management System - Backend (modular monolith, single app)",
  "private": true,
  "packageManager": "npm@11.10.0",
  "workspaces": [
    "app-server"
  ],
  "scripts": {
    "build": "npm --prefix app-server run build",
    "build:app": "npm --prefix app-server run build",
    "start": "npm --prefix app-server run start",
    "postdeploy": "npm --prefix app-server run postdeploy",
    "start:dev": "npm --prefix app-server run dev",
    "migrate": "npm --prefix app-server run migrate:deploy",
    "migrate:dev": "npm --prefix app-server run migrate:dev",
    "seed": "npm --prefix app-server run db:seed",
    "test": "npm --prefix app-server run test",
    "lint": "npm --prefix app-server run lint"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
