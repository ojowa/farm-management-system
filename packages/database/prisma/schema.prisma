generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?  @unique
  phone     String?
  logo      String?
  website   String?
  industry  String?

  subscriptionPlan     String   @default("FREE")
  subscriptionStatus   String   @default("TRIAL")
  subscriptionPlanId   String?
  settings             Json     @default("{}")

  users     User[]
  farms     Farm[]
  memberships UserOrganization[]
  roles      Role[]
  featureOverrides FeatureFlagOverride[]
  subscriptionPlanRef SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id              String   @id @default(uuid())
  organizationId  String

  firstName       String
  lastName        String
  middleName      String?
  email           String?  @unique
  phone           String?  @unique

  passwordHash    String
  roleId          String
  avatar          String?

  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  role            Role         @relation(fields: [roleId], references: [id])

  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  memberships     UserOrganization[]
  sessions        UserSession[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model UserOrganization {
  id              String   @id @default(uuid())
  userId          String
  organizationId  String
  roleInOrg       String   @default("WORKER")
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Role {
  id             String @id @default(uuid())
  name           String
  description    String?
  isSystem       Boolean @default(false)
  organizationId String?

  permissions    RolePermission[]
  users          User[]
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
}

model Permission {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  category    String?

  roles       RolePermission[]

  createdAt   DateTime @default(now())
}

model RolePermission {
  roleId        String
  permissionId  String

  role          Role       @relation(fields: [roleId], references: [id])
  permission    Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  revoked     Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@index([userId])
}

model Farm {
  id              String   @id @default(uuid())
  organizationId  String

  name            String
  farmType        String   // CROP, LIVESTOCK, POULTRY, DAIRY, AQUACULTURE
  location        String?
  latitude        Float?
  longitude       Float?
  size            Float    @default(0)
  status          String   @default("active")

  organization    Organization @relation(fields: [organizationId], references: [id])

  fields          Field[]
  poultryHouses   PoultryHouse[]
  flocks          Flock[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([farmType])
}

model Field {
  id        String @id @default(uuid())
  farmId    String
  name      String
  size      Float

  farm      Farm @relation(fields: [farmId], references: [id])

  cropCycles CropCycle[]

  @@index([farmId])
}

model PoultryHouse {
  id        String @id @default(uuid())
  farmId    String
  name      String
  capacity  Int

  farm      Farm @relation(fields: [farmId], references: [id])
  pens      Pen[]

  @@index([farmId])
}

model Pen {
  id              String @id @default(uuid())
  poultryHouseId  String
  name            String
  capacity        Int

  poultryHouse    PoultryHouse @relation(fields: [poultryHouseId], references: [id])

  flocks          Flock[]

  @@index([poultryHouseId])
}

model Breed {
  id        String @id @default(uuid())
  name      String
  birdType  String // Enum-like string (BROILER, LAYER, etc)

  flocks    Flock[]
}

model Flock {
  id              String @id @default(uuid())
  organizationId  String
  farmId          String
  penId           String
  breedId         String

  batchCode       String @unique
  birdCount       Int
  currentCount    Int

  arrivalDate     DateTime
  currentAgeDays  Int

  status          String // Enum-like string (ACTIVE, SOLD, etc)

  farm            Farm @relation(fields: [farmId], references: [id])
  pen             Pen @relation(fields: [penId], references: [id])
  breed           Breed @relation(fields: [breedId], references: [id])

  feedingRecords   FeedingRecord[]
  vaccinationRecords VaccinationRecord[]
  mortalityRecords MortalityRecord[]
  medications     Medication[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([farmId])
}

model FeedingRecord {
  id        String @id @default(uuid())
  flockId   String

  feedType  String
  quantityKg Float
  date      DateTime

  flock     Flock @relation(fields: [flockId], references: [id])

  createdAt DateTime @default(now())
}

model VaccinationRecord {
  id        String @id @default(uuid())
  flockId   String

  vaccine   String
  dosage    String?
  date      DateTime

  flock     Flock @relation(fields: [flockId], references: [id])

  createdAt DateTime @default(now())
}

model MortalityRecord {
  id        String @id @default(uuid())
  flockId   String

  count     Int
  cause     String?
  date      DateTime

  flock     Flock @relation(fields: [flockId], references: [id])

  createdAt DateTime @default(now())
}

model Medication {
  id          String    @id @default(uuid())
  flockId     String
  name        String
  dosage      String
  frequency   String
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  status      String    @default("ACTIVE")
  flock       Flock     @relation(fields: [flockId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([flockId])
  @@index([status])
}

model Crop {
  id    String @id @default(uuid())
  name  String

  cropCycles CropCycle[]
}

model CropCycle {
  id            String @id @default(uuid())
  fieldId       String
  cropId        String

  plantingDate  DateTime
  harvestDate   DateTime?
  health        Int    @default(100)
  status        String @default("growing")

  field         Field @relation(fields: [fieldId], references: [id])
  crop          Crop @relation(fields: [cropId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Inventory {
  id        String @id @default(uuid())
  farmId    String

  name      String
  category  String
  quantity  Float
  unit      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

model Expense {
  id        String @id @default(uuid())
  farmId    String

  title     String
  amount    Float
  date      DateTime

  createdAt DateTime @default(now())
}

model Sale {
  id        String @id @default(uuid())
  farmId    String

  item      String
  quantity  Float
  price     Float
  total     Float

  date      DateTime

  createdAt DateTime @default(now())
}

model Worker {
  id        String @id @default(uuid())
  farmId    String

  name      String
  role      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String @id @default(uuid())

  userId    String?
  action    String
  entity    String
  entityId  String

  user      User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model SyncQueue {
  id        String @id @default(uuid())

  entity    String
  entityId  String
  operation String
  payload   String

  synced    Boolean  @default(false)

  createdAt DateTime @default(now())
}

model Livestock {
  id        String   @id @default(uuid())
  farmId    String
  species   String
  breed     String?
  gender    String
  birthDate DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  entityType String?
  entityId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String   // "web", "ios", "android"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@index([token])
  @@index([active])
}

model Task {
  id             String   @id @default(uuid())
  organizationId String
  farmId         String?
  title          String
  description    String?
  priority       String   @default("MEDIUM")
  status         String   @default("PENDING")

  assignedToId   String?
  assignedToName String?
  createdById    String?
  createdByName  String?

  dueDate        DateTime?
  completedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
}

model LeaveType {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  daysPerYear    Int      @default(0)
  isPaid         Boolean  @default(true)
  isActive       Boolean  @default(true)

  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
}

model LeaveRequest {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  days           Int
  reason         String?
  status         String   @default("PENDING")
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String?

  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

model LeaveBalance {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  leaveTypeId    String
  year           Int
  totalDays      Int      @default(0)
  usedDays       Int      @default(0)

  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([organizationId])
  @@index([userId])
}

// ── Phase 2: Duty Roster ──────────────────────────────────

model Shift {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  startTime      String   // "08:00"
  endTime        String   // "16:00"
  color          String?  @default("#3B82F6")
  isActive       Boolean  @default(true)

  assignments    ShiftAssignment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
}

model ShiftAssignment {
  id             String   @id @default(uuid())
  organizationId String
  shiftId        String
  userId         String
  date           DateTime // date only (no time)
  notes          String?

  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([shiftId, userId, date])
  @@index([organizationId])
  @@index([userId])
  @@index([date])
}

// ── Phase 3: Internal Messaging ───────────────────────────

model Message {
  id             String   @id @default(uuid())
  organizationId String
  senderId       String
  senderName     String
  subject        String
  body           String
  priority       String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  recipients     MessageRecipient[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageRecipient {
  id             String   @id @default(uuid())
  messageId      String
  recipientId    String
  recipientName  String
  organizationId String
  isRead         Boolean  @default(false)
  readAt         DateTime?

  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([messageId, recipientId])
  @@index([recipientId])
  @@index([organizationId])
  @@index([isRead])
}

// ── Phase 4: Correspondence ───────────────────────────────

model Correspondence {
  id              String   @id @default(uuid())
  organizationId  String
  referenceNumber String   @unique
  title           String
  type            String   // INCOMING, OUTGOING, INTERNAL
  category        String   @default("OTHER") // MEMO, LETTER, REPORT, NOTICE, OTHER
  from            String?  // sender/originator
  to              String?  // recipient/destination
  content         String?
  status          String   @default("DRAFT") // DRAFT, SENT, RECEIVED, ARCHIVED
  priority        String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  receivedDate    DateTime?
  createdById     String
  createdByName   String
  archivedAt      DateTime?

  attachments     CorrespondenceAttachment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([createdById])
}

model CorrespondenceAttachment {
  id              String   @id @default(uuid())
  correspondenceId String
  fileName        String
  fileSize        Int
  fileUrl         String
  fileType        String?
  uploadedById    String
  organizationId  String

  correspondence  Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([correspondenceId])
  @@index([organizationId])
}

// ── Platform Console: Feature Flags ───────────────────────

model FeatureFlag {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  description   String?
  category      String   @default("core")
  defaultValue  Boolean  @default(true)
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgOverrides  FeatureFlagOverride[]
}

model FeatureFlagOverride {
  id              String      @id @default(uuid())
  featureFlagId   String
  organizationId  String
  isEnabled       Boolean
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  featureFlag     FeatureFlag  @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, organizationId])
  @@index([organizationId])
}

// ── Platform Console: Subscriptions ───────────────────────

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique
  displayName   String
  description   String?
  price         Decimal  @default(0)
  currency      String   @default("USD")
  billingCycle  String   @default("MONTHLY")
  maxUsers      Int      @default(5)
  maxFarms      Int      @default(1)
  maxStorage    Int      @default(100)
  features      Json     @default("[]")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizations Organization[]
}

// ── Platform Console: User Sessions ───────────────────────

model UserSession {
  id          String   @id @default(uuid())
  userId      String
  app         String
  deviceInfo  Json?
  ipAddress   String?
  isActive    Boolean  @default(true)
  loginAt     DateTime @default(now())
  lastActive  DateTime @default(now())
  logoutAt    DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([app])
  @@index([isActive])
}

// ── Platform Console: System Health ───────────────────────

model SystemHealth {
  id          String   @id @default(uuid())
  serviceName String
  status      String   @default("healthy")
  uptime      Int      @default(0)
  memoryUsage Json?
  lastCheck   DateTime @default(now())
  metadata    Json?

  @@unique([serviceName])
  @@index([status])
  @@index([lastCheck])
}

// ── Platform Console: Broadcasts ──────────────────────────

model Broadcast {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("INFO")
  targetOrgs  String[] @default([])
  isActive    Boolean  @default(true)
  startsAt    DateTime @default(now())
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt])
}

// ── Platform Console: Platform Config ─────────────────────

model PlatformConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
