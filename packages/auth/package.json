{
  "name": "@farm/auth",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "nestjs": ["./dist/nestjs/index.d.ts"],
      "rn": ["./dist/rn.d.ts"],
      "paths": ["./dist/paths.d.ts"]
    }
  },
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./rn": {
      "types": "./dist/rn.d.ts",
      "default": "./dist/rn.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx src/jwt.spec.ts"
  },
  "dependencies": {
    "@farm/types": "workspace:*",
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.5",
    "typescript": "^5.8.3",
    "tsx": "^4.19.2"
  }
}
