generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Livestock {
  id        String   @id @default(uuid())
  farmId    String
  species   String
  breed     String?
  gender    String   // 'MALE' | 'FEMALE'
  birthDate DateTime
  status    String   // 'HEALTHY' | 'SICK' | 'SOLD' | 'DECEASED'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

