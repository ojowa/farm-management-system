generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String   // 'INFO' | 'WARNING' | 'ALERT' | 'SUCCESS'
  link       String?
  isRead     Boolean  @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

